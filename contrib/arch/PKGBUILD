pkgname=caco
pkgver=0.0.0
pkgrel=1
pkgdesc="Doom WAD library manager"
arch=('x86_64')
url="https://github.com/mythofmeat/caco"
license=('MIT')
depends=('openssl' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'desktop-file-utils')
optdepends=(
    'vulkan-driver: GPU-accelerated rendering'
    'xdg-desktop-portal: native file dialogs'
    'git: building sourceports from source'
)
makedepends=('rust' 'pkgconf')
options=('!lto' '!debug' 'strip')

_worktree() {
    cd "$startdir/../.."
}

build() {
    _worktree
    cargo build --workspace --release
}

check() {
    _worktree
    cargo test --workspace
}

package() {
    _worktree

    install -Dm755 target/release/caco "$pkgdir/usr/bin/caco"

    install -Dm644 assets/caco.desktop "$pkgdir/usr/share/applications/caco.desktop"

    install -Dm644 assets/icons/caco-256.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/caco.png"
    install -Dm644 assets/icons/caco-128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/caco.png"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
